# Copy this file to `.env` and fill in the two values, then restart the dev server.
#
#   cp .env.example .env          # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# Both are read at *build time* (they are `import.meta.env`, baked into the bundle),
# so a change here needs the dev server restarted — a page refresh will not pick it up.
#
# `src/lib/supabase.ts` throws on startup if either is missing. A blank white page
# with "Missing Supabase environment variables" in the browser console means this
# file, not the code.

# Your Supabase project URL — Supabase dashboard > Project Settings > Data API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# The *anon* key — dashboard > Project Settings > API Keys > `anon` / `public`.
# This one is designed to ship in the browser bundle, so it is not a secret in the
# way the service_role key or a personal access token is. It is still a credential:
# what stops it reading the whole database is row-level security, which the
# migrations in supabase/ set up. Never put the service_role key here — it bypasses
# RLS entirely and this file is compiled into client-side JavaScript.
VITE_SUPABASE_ANON_KEY=<your-anon-key>
